# Database Configuration
POSTGRES_DB=gitduppy
POSTGRES_USER=gitduppy
POSTGRES_PASSWORD=gitduppy
DATABASE_URL=postgres://gitduppy:gitduppy@postgres:5432/gitduppy?sslmode=disable

# Server Configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# Encryption key for stored repository credentials (required).
# Generate with: openssl rand -hex 32
# Placeholder or low-entropy keys are refused at startup.
ENCRYPTION_KEY=

# Reverse proxies (IPs/CIDRs, comma-separated) whose X-Forwarded-For is trusted.
# Leave empty when clients connect directly.
TRUSTED_PROXIES=

# SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=user@example.com
SMTP_PASSWORD=password
SMTP_FROM_EMAIL=noreply@yourdomain.com

# OAuth2 Configuration
OAUTH2_GITHUB_CLIENT_ID=
OAUTH2_GITHUB_CLIENT_SECRET=
OAUTH2_GOOGLE_CLIENT_ID=
OAUTH2_GOOGLE_CLIENT_SECRET=
# Email domains allowed to self-register via OAuth (comma-separated, empty = any).
OAUTH_ALLOWED_EMAIL_DOMAINS=
# New OAuth accounts are inactive until an admin enables them unless true.
OAUTH_AUTO_ACTIVATE=false

# Production Caddy Configuration
docker-compose.prod.yml specific:
DOMAIN=yourdomain.com
EMAIL=admin@yourdomain.com